# ── 基于预测的检查点调度决策规则 ───────────────────────────────────────────

def checkpoint_scheduling_rule(pred_net_load: np.ndarray,
                                 thr_low:  float,
                                 thr_high: float) -> dict:
    max_pred  = pred_net_load.max(axis=1)
    decisions = np.where(max_pred < thr_low,  "SCHEDULE",
                np.where(max_pred > thr_high, "DEFER", "NEUTRAL"))
    n_sch  = (decisions == "SCHEDULE").sum()
    n_def  = (decisions == "DEFER").sum()
    n_neu  = (decisions == "NEUTRAL").sum()
    sch_mask = decisions == "SCHEDULE"
    def_mask = decisions == "DEFER"
    avg_sch = float(pred_net_load[sch_mask].mean()) if sch_mask.any() else thr_low
    avg_def = float(pred_net_load[def_mask].mean()) if def_mask.any() else thr_high
    load_shift_benefit = avg_def - avg_sch        # 节省的功率（归一化）
    print(f"\n  [调度决策规则] 阈值: low={thr_low:.3f}, high={thr_high:.3f}")
    print(f"    立即调度: {n_sch}次 ({n_sch/len(decisions)*100:.1f}%)")
    print(f"    推迟:     {n_def}次 ({n_def/len(decisions)*100:.1f}%)")
    print(f"    中性:     {n_neu}次 ({n_neu/len(decisions)*100:.1f}%)")
    print(f"    峰谷差收益: Δload={load_shift_benefit:.4f}（归一化功率单位）")
    return dict(decisions=decisions, n_schedule=int(n_sch),
                n_defer=int(n_def), n_neutral=int(n_neu),
                load_shift_benefit=load_shift_benefit,
                avg_load_schedule=avg_sch, avg_load_defer=avg_def)


# ── 极值事件F1计算 ─────────────────────────────────────────────

def compute_extreme_threshold(y_train: np.ndarray, n_std: float = 2.0) -> float:
    thr = float(y_train.mean() + n_std * y_train.std())
    pos_rate = float((y_train.max(axis=1) > thr).mean())
    print(f"  [极值阈值] mean+{n_std}σ = {thr:.4f}, "
          f"训练集正样本率={pos_rate*100:.1f}%")
    return thr
