# ── A2/D1: 无Lorenz注入的原始GPU数据MF-DFA基准 ─────────────────────────────

def no_lorenz_baseline(job_csv, node_csv, bin_sec=600):
    job  = pd.read_csv(job_csv).dropna(subset=["submit_time","duration"]).copy()
    node = pd.read_csv(node_csv)
    job["gpu_demand"] = job["gpu_request"].fillna(0) * job["worker_num"].fillna(1)
    job["end_time"]   = job["submit_time"] + job["duration"]
    t_min = float(job["submit_time"].min())
    t_max = float(job["end_time"].max())
    n_bins = int((t_max - t_min) / bin_sec) + 1
    total_gpu = int(node["gpu_capacity_num"].sum())

    demand = np.zeros(n_bins + 2)
    s_idx  = np.clip(np.floor((job["submit_time"].values - t_min)/bin_sec).astype(int), 0, n_bins)
    e_idx  = np.clip(np.floor((job["end_time"].values    - t_min)/bin_sec).astype(int)+1, 0, n_bins)
    np.add.at(demand, s_idx,  job["gpu_demand"].values)
    np.add.at(demand, e_idx, -job["gpu_demand"].values)
    gpu_raw = np.cumsum(demand[:n_bins]).astype(np.float32) / (total_gpu + 1e-8)

    gpu_raw = _wavelet_denoise(np.clip(gpu_raw, 0, None))
    gpu_raw = _minmax(gpu_raw)
    mf = MFDFA()
    seg_len = min(4096, len(gpu_raw))
    r_raw   = mf.fit(gpu_raw[:seg_len])
    print(f"\n  [无Lorenz基准] Δα={r_raw['delta_alpha']:.4f}, "
          f"H_mono={r_raw['H_mono']:.4f}")
    return gpu_raw, r_raw


def raw_vs_denoised_mfdfa(series_raw: np.ndarray, label: str = "net"):
    mf   = MFDFA()
    seg  = series_raw[:min(4096, len(series_raw))].astype(np.float32)
    r_raw    = mf.fit(seg)
