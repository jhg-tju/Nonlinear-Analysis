def sensitivity_smin(series):
    seg = series[200:200+1024]
    results = {}
    for s_min in [10, 20, 30, 50, 80]:
        mf  = MFDFA(min_s=s_min)
        das = [mf.fit(seg + 0.02*np.random.randn(len(seg)))["delta_alpha"]
               for _ in range(40)]
        results[s_min] = (float(np.mean(das)), float(np.std(das)))
        print(f"    s_min={s_min:3d}: Δα={results[s_min][0]:.4f}±{results[s_min][1]:.4f}")
    return results


def sensitivity_noise(series):
    seg = series[200:200+1024]
    mf  = MFDFA()
    results = {}
    for sigma in [0.0, 0.01, 0.05, 0.10, 0.20]:
        das = [mf.fit(seg + sigma*np.random.randn(len(seg)))["delta_alpha"]
               for _ in range(30)]
        results[sigma] = (float(np.mean(das)), float(np.std(das)))
        print(f"    noise={sigma:.2f}: Δα={results[sigma][0]:.4f}±{results[sigma][1]:.4f}")
    return results


# ──  消融实验 ─────────────────────────────────────────────────────────────

def run_ablation(loaders, window, horizon, da_mean, da_std):
    tr_loader, val_loader, te_loader = loaders
    results = {}
    for nl_dim, tag in [(1, "仅Δα (1维)"), (2, "[Δα,α₀] (2维)"),
                        (3, "完整[Δα,α₀,Hm] (3维)")]:
        print(f"\n  ── 消融实验: {tag} ──")
        ldr = (_make_truncated_loader(tr_loader, nl_dim, shuffle=True),
               _make_truncated_loader(val_loader, nl_dim, shuffle=False),
               _make_truncated_loader(te_loader,  nl_dim, shuffle=False))
        model = MFTransformer(window, horizon, nl=nl_dim, adaptive=True)
        model, _, _ = train(model, ldr, f"Ablation_{nl_dim}d",
                           use_nl=True, da_mean=da_mean, da_std=da_std)
        res = evaluate(model, ldr[2], use_nl=True)
        results[tag] = res
        print(f"    RMSE={res['RMSE']:.5f}, CC={res['CC']:.4f}, F1={res['F1']:.4f}")
    return results


