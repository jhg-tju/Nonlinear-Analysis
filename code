# ── B1：预测差异显著性检验 ──────────────────────────────────

def diebold_mariano_test(pred_a: np.ndarray,
                         pred_b: np.ndarray,
                         actual: np.ndarray,
                         loss_fn: str = "mse") -> tuple:
    from scipy import stats as sp_stats
    e_a = pred_a.flatten() - actual.flatten()
    e_b = pred_b.flatten() - actual.flatten()
    d   = (e_a**2 - e_b**2) if loss_fn == "mse" else (np.abs(e_a) - np.abs(e_b))
    n   = len(d)
    d_bar = float(d.mean())
    autocov = float(np.cov(d[1:], d[:-1])[0, 1]) if n > 2 else 0.0
    var_d   = max((float(np.var(d, ddof=1)) + 2 * autocov) / n, 1e-12)
    dm_stat = d_bar / math.sqrt(var_d)
    p_value = float(2 * sp_stats.t.sf(abs(dm_stat), df=n - 1))
    return dm_stat, p_value


def multi_seed_eval(loaders, window, horizon, da_mean, da_std,
                    seeds=(42, 123, 456)):
    print(f"\n  [多seed实验] seeds={list(seeds)}")
    res_mf_all, res_b1_all = [], []
    _, _, te_loader = loaders
    for seed in seeds:
        torch.manual_seed(seed); np.random.seed(seed); random.seed(seed)
        mf = MFTransformer(window, horizon, adaptive=True)
        b1 = MFTransformer(window, horizon, adaptive=False)
        mf, _, _ = train(mf, loaders, f"MF_s{seed}", use_nl=True,
                        da_mean=da_mean, da_std=da_std)
        b1, _, _ = train(b1, loaders, f"B1_s{seed}", use_nl=False)
        res_mf_all.append(evaluate(mf, te_loader, use_nl=True))
        res_b1_all.append(evaluate(b1, te_loader, use_nl=False))
        print(f"    seed={seed}: MF RMSE={res_mf_all[-1]['RMSE']:.5f}, "
              f"B1 RMSE={res_b1_all[-1]['RMSE']:.5f}")

    summary = {}
    for name, res_list in [("MFTransformer", res_mf_all), ("Base-1", res_b1_all)]:
        summary[name] = {}
        for m in ["RMSE", "MAE", "CC", "F1"]:
            vals = [r[m] for r in res_list]
            summary[name][m] = (float(np.mean(vals)), float(np.std(vals)))
        print(f"    {name}: RMSE={summary[name]['RMSE'][0]:.5f}"
              f"±{summary[name]['RMSE'][1]:.5f}")
    return summary, res_mf_all, res_b1_all



def persistence_baseline(X_te: np.ndarray, y_te: np.ndarray,
                          extreme_thr: float) -> dict:
    preds = np.repeat(X_te[:, -1:], HORIZON, axis=1)
    flat_p, flat_t = preds.flatten(), y_te.flatten()
    rmse = math.sqrt(mean_squared_error(flat_t, flat_p))
    mae  = mean_absolute_error(flat_t, flat_p)
    cc   = float(np.corrcoef(flat_t, flat_p)[0, 1])
    t_ext = y_te.max(axis=1)  > extreme_thr
    p_ext = preds.max(axis=1) > extreme_thr
    f1    = f1_score(t_ext, p_ext, zero_division=0)
    return dict(RMSE=rmse, MAE=mae, CC=cc, F1=f1, preds=preds, tgts=y_te)


def seasonal_naive_baseline(target_series: np.ndarray,
                             X_te: np.ndarray, y_te: np.ndarray,
                             n_test: int, extreme_thr: float,
                             season_steps: int = 144) -> dict:

    n_total = len(target_series)
    n_tr    = n_total - n_test
    preds   = []
    for i in range(n_test):
        start_in_series = n_tr + i * STRIDE
        pred_start = start_in_series + WINDOW 
        ref_start = max(pred_start - season_steps, 0)
        ref_end   = ref_start + HORIZON
        if ref_end <= n_total:
            preds.append(target_series[ref_start:ref_end])
        else:
            preds.append(np.repeat(target_series[-1], HORIZON))
    preds = np.array(preds, dtype=np.float32)
    if len(preds) < len(y_te):
        y_te = y_te[:len(preds)]
    flat_p, flat_t = preds.flatten(), y_te.flatten()
    rmse = math.sqrt(mean_squared_error(flat_t, flat_p))
    mae  = mean_absolute_error(flat_t, flat_p)
    cc   = float(np.corrcoef(flat_t, flat_p)[0, 1])
    t_ext = y_te.max(axis=1)  > extreme_thr
    p_ext = preds.max(axis=1) > extreme_thr
    f1    = f1_score(t_ext, p_ext, zero_division=0)
    return dict(RMSE=rmse, MAE=mae, CC=cc, F1=f1, preds=preds, tgts=y_te)


# ──窗口长度消融实验 ─────────────────────────────────────────────────────

def window_size_ablation(target_series: np.ndarray,
                         nl_feat: np.ndarray,
                         da_mean: float, da_std: float):
    results = {}
    for win, label in [(36, "6h"), (72, "12h(默认)"), (144, "24h"), (288, "48h")]:
        print(f"\n  ── 窗口消融: WINDOW={win}步 ({label}) ──")
        X, y = _sliding_window(target_series, win, HORIZON, STRIDE)
        nl_a = []
        for i in range(0, len(target_series) - win - HORIZON + 1, STRIDE):
            idx = min((i + win) // MFDFA_STRIDE, len(nl_feat) - 1)
            nl_a.append(nl_feat[idx])
        nl_a = np.array(nl_a, np.float32)
        n = min(len(X), len(nl_a))
        X, y, nl_a = X[:n], y[:n], nl_a[:n]
        X_tr, X_v, X_te, y_tr, y_v, y_te = _split(X, y)
        n1, n2 = int(n * .7), int(n * .8)
        nl_tr, nl_v, nl_te = nl_a[:n1], nl_a[n1:n2], nl_a[n2:]
        sc = StandardScaler()
        nl_tr = sc.fit_transform(nl_tr).astype(np.float32)
        nl_v  = sc.transform(nl_v).astype(np.float32)
        nl_te = sc.transform(nl_te).astype(np.float32)
        loaders = make_loaders(X_tr, X_v, X_te, y_tr, y_v, y_te, nl_tr, nl_v, nl_te)
        model = MFTransformer(win, HORIZON, adaptive=True)
        model, _, _ = train(model, loaders, f"Win{win}",
                           use_nl=True, da_mean=da_mean, da_std=da_std)
        _, _, te_l = loaders
        ethr = float(y_tr.mean() + 2 * y_tr.std())
        res  = evaluate(model, te_l, use_nl=True, extreme_threshold=ethr)
        results[label] = res
        print(f"    RMSE={res['RMSE']:.5f}, CC={res['CC']:.4f}, F1={res['F1']:.4f}")
    return results


