def load_wind_power() -> np.ndarray:
    df = pd.read_csv(WIND_CSV, comment="#", header=0, usecols=[0, 1, 2])
    df.columns = ["dt", "ws", "pw"]
    df["pw"] = pd.to_numeric(df["pw"], errors="coerce")
    df = df.dropna(subset=["pw"]).reset_index(drop=True)
    pw = np.clip(df["pw"].values.astype(np.float32), 0, None)
    pw = _wavelet_denoise(pw)
    pw = _minmax(pw)
    print(f"  [Wind]  有效点数={len(pw)}, 均值={pw.mean():.3f}, std={pw.std():.3f}")
    return pw

def load_gpu_load(bin_sec: int = 600) -> np.ndarray:
    job  = pd.read_csv(JOB_CSV)
    node = pd.read_csv(NODE_CSV)
    job  = job.dropna(subset=["submit_time", "duration"]).copy()
    job["gpu_demand"] = job["gpu_request"].fillna(0) * job["worker_num"].fillna(1)
    job["end_time"]   = job["submit_time"] + job["duration"]

    t_min = float(job["submit_time"].min())
    t_max = float(job["end_time"].max())
    n_bins = int((t_max - t_min) / bin_sec) + 1
    total_gpu = int(node["gpu_capacity_num"].sum())

    demand = np.zeros(n_bins + 2, dtype=np.float64)
    s_idx  = np.clip(np.floor((job["submit_time"].values - t_min) / bin_sec).astype(int), 0, n_bins)
    e_idx  = np.clip(np.floor((job["end_time"].values    - t_min) / bin_sec).astype(int) + 1, 0, n_bins)
    np.add.at(demand, s_idx,  job["gpu_demand"].values)
    np.add.at(demand, e_idx, -job["gpu_demand"].values)
    gpu_ts   = np.cumsum(demand[:n_bins]).astype(np.float32)
    util_ts  = gpu_ts / (total_gpu + 1e-8)

    # ── 检查点 I/O 阻塞功耗模型 ──
    llm_jobs = job[
        job["gpu_model"].isin(["H800", "A100-SXM4-80GB", "A800-SXM4-80GB"]) &
        (job["job_type"] == "HP") &
        (job["duration"] > 3600)
    ].copy()
    ckpt_ratio    = np.ones(n_bins, dtype=np.float32)
    ckpt_interval = int(30 * 60 / bin_sec)
    ckpt_duration = max(1, int(5  * 60 / bin_sec))
    llm_demand = np.zeros(n_bins + 2, dtype=np.float64)
    ls = np.clip(np.floor((llm_jobs["submit_time"].values - t_min)/bin_sec).astype(int), 0, n_bins)
    le = np.clip(np.floor((llm_jobs["end_time"].values    - t_min)/bin_sec).astype(int)+1, 0, n_bins)
    np.add.at(llm_demand, ls,  llm_jobs["gpu_demand"].values)
    np.add.at(llm_demand, le, -llm_jobs["gpu_demand"].values)
    llm_active = np.cumsum(llm_demand[:n_bins]) > 0
    for t in range(0, n_bins, ckpt_interval):
        end_t = min(t + ckpt_duration, n_bins)
        ckpt_ratio[t:end_t] = np.where(llm_active[t:end_t], 0.45, 1.0)
    gpu_power = util_ts * ckpt_ratio

    # ── Lorenz 混沌扰动──
    rng   = np.random.default_rng(SEED)
    chaos = _lorenz_series(n_bins + 2000, rho=28)[:n_bins]
    chaos = (chaos - chaos.min()) / (chaos.max() - chaos.min() + 1e-8)
    noise = rng.normal(0, 0.02, n_bins).astype(np.float32)
    gpu_power = np.clip(gpu_power * (1.0 + 0.08 * chaos + noise), 0, None).astype(np.float32)
    gpu_power = _wavelet_denoise(gpu_power)
    gpu_power = _minmax(gpu_power)

    print(f"  [GPU]   作业总数={len(job):,}, LLM训练作业={len(llm_jobs):,}, "
          f"集群GPU总量={total_gpu}卡")
    print(f"          时间槽数={n_bins}, 跨度={(t_max-t_min)/86400:.1f}天, "
          f"均值={gpu_power.mean():.3f}, std={gpu_power.std():.3f}")
    return gpu_power


def align_series(wind: np.ndarray, gpu: np.ndarray):
    n = min(len(wind), len(gpu))
    wind, gpu = wind[:n], gpu[:n]
    net = _minmax(np.clip(gpu - wind + 0.5, 0, 1))
    print(f"  [Align] 对齐后长度={n} ({n*10/60:.1f}h = {n*10/1440:.1f}天)")
    return wind[:n], gpu[:n], net[:n]


# ── 辅助函数 ─────────────────────────────────────────────────────────────────

def _lorenz_series(n, dt=0.01, sigma=10, rho=28, beta=8/3):
    x, y, z = 0.1, 0.0, 0.0
    xs = []
    for i in range(n + 500):
        dx = sigma*(y-x); dy = x*(rho-z)-y; dz = x*y-beta*z
        x += dx*dt; y += dy*dt; z += dz*dt
        if i >= 500: xs.append(x)
    return np.array(xs[:n], dtype=np.float32)

def _wavelet_denoise(x):
    try:
        import pywt
        c = pywt.wavedec(x, "db4", level=3)
        sigma = np.median(np.abs(c[-1])) / 0.6745
        thr   = sigma * np.sqrt(2 * np.log(len(x)))
        c2    = [pywt.threshold(ci, thr, mode="soft") for ci in c]
        return pywt.waverec(c2, "db4")[:len(x)].astype(np.float32)
    except ImportError:
        b, a = butter(4, 0.05, btype="low")
        return filtfilt(b, a, x).astype(np.float32)

def _minmax(x):
    xmin, xmax = x.min(), x.max()
    return ((x - xmin) / (xmax - xmin + 1e-8)).astype(np.float32)

def _split(X, y, r=(0.7, 0.1, 0.2)):
    n = len(X)
    n1, n2 = int(n*r[0]), int(n*(r[0]+r[1]))
    return X[:n1], X[n1:n2], X[n2:], y[:n1], y[n1:n2], y[n2:]

def _sliding_window(series, window, horizon, stride):
    X, y = [], []
    for i in range(0, len(series)-window-horizon+1, stride):
        X.append(series[i:i+window])
        y.append(series[i+window:i+window+horizon])
    return np.array(X, np.float32), np.array(y, np.float32)


# : 相空间重构参数确定      

def _ami(x: np.ndarray, tau: int, n_bins: int = 32) -> float:
    """
    计算时间序列 x(t) 与 x(t+τ) 之间的平均互信息量（Average Mutual Information）。
    用于寻找使 AMI 首次出现局部最小值的延迟 τ，作为最优嵌入延迟。
    """
    x = np.asarray(x, dtype=float)
    y, z = x[:-tau], x[tau:]
    joint, _, _ = np.histogram2d(y, z, bins=n_bins)
    px = joint.sum(axis=1); pz = joint.sum(axis=0)
    px = px / (px.sum() + 1e-12); pz = pz / (pz.sum() + 1e-12)
    joint = joint / (joint.sum() + 1e-12)
    outer = np.outer(px, pz)
    mask  = joint > 0
    mi    = float((joint[mask] * np.log(joint[mask] / (outer[mask] + 1e-12))).sum())
    return mi


def _fnn(x: np.ndarray, tau: int, max_m: int = 8, rtol: float = 15.0) -> list:
    N = len(x)
    fnn_rates = []
    for m in range(1, max_m + 1):
        n_pts = N - m * tau
        if n_pts < 20:
            fnn_rates.append(0.0)
            break
        Y_m  = np.array([x[i : i + m * tau : tau] for i in range(n_pts)])
        x_next = np.array([x[i + m * tau]           for i in range(n_pts)])
        nbrs = NearestNeighbors(n_neighbors=2, algorithm="ball_tree").fit(Y_m)
        dists, idxs = nbrs.kneighbors(Y_m)
        r_m    = dists[:, 1]     
        nn_idx = idxs[:, 1]
        extra  = np.abs(x_next - x_next[nn_idx])  
        ratio  = extra / (r_m + 1e-10)
        fnn_rate = float((ratio > rtol).mean())
        fnn_rates.append(fnn_rate)
        print(f"    FNN m={m}: 虚假近邻率={fnn_rate:.4f}")
        if fnn_rate < 0.05:   # < 5% 阈值
            break
    return fnn_rates


def determine_embedding_params(series: np.ndarray,
                                max_tau: int = 50,
                                max_m:   int = 8,
                                n_bins:  int = 32,
                                cache_path: str = None):

    if cache_path and os.path.exists(cache_path):
        d = np.load(cache_path, allow_pickle=True).item()
        print(f"  [Embedding] 载入缓存: τ_opt={d['tau']}, m_opt={d['m']}")
        return d["tau"], d["m"], d["ami_vals"], d["fnn_rates"]

    seg = series[:min(3000, len(series))].astype(float)

    # Step 1: AMI → 找首个局部最小值
    print(f"  [Embedding] 计算 AMI (max_tau={max_tau})...")
    ami_vals = [_ami(seg, tau, n_bins) for tau in range(1, max_tau + 1)]
    tau_opt = 1
    for i in range(1, len(ami_vals) - 1):
        if ami_vals[i] < ami_vals[i - 1] and ami_vals[i] <= ami_vals[i + 1]:
            tau_opt = i + 1
            break
    print(f"  [Embedding] τ_opt={tau_opt} (AMI 首次局部最小)")

    # Step 2: FNN → 找 FNN 率首次降至 < 5% 的维度
    print(f"  [Embedding] 计算 FNN (τ={tau_opt}, max_m={max_m})...")
    fnn_rates = _fnn(seg, tau_opt, max_m=max_m)
    m_opt = len(fnn_rates)
    for i, r in enumerate(fnn_rates):
        if r < 0.05:
            m_opt = i + 1
            break
    print(f"  [Embedding] m_opt={m_opt} (FNN < 5% 虚假近邻)")

    if cache_path:
        np.save(cache_path, {"tau": tau_opt, "m": m_opt,
                             "ami_vals": ami_vals, "fnn_rates": fnn_rates})
    return tau_opt, m_opt, ami_vals, fnn_rates


#  2. MF-DFA 

class MFDFA:
    def __init__(self, q_list=None, poly=2, min_s=30, n_scales=20, ratio=0.25):
        if q_list is None:
            q_list = np.concatenate([np.arange(-5, 0, 0.5), np.arange(0.5, 5.5, 0.5)])
        self.q = np.array(q_list, dtype=float)
        self.poly = poly; self.min_s = min_s
        self.n_scales = n_scales; self.ratio = ratio

    def fit(self, x):
        x = np.asarray(x, float)
        N = len(x)
        Y = np.cumsum(x - x.mean())
        s_max  = max(int(N * self.ratio), self.min_s + 1)
        scales = np.unique(
            np.logspace(np.log10(self.min_s), np.log10(s_max),
                        self.n_scales).astype(int))
        Fq = np.zeros((len(self.q), len(scales)))
        for si, s in enumerate(scales):
            var = self._variances(Y, s)
            for qi, q in enumerate(self.q):
                if abs(q) < 1e-8:
                    Fq[qi, si] = np.exp(0.5 * np.mean(np.log(var + 1e-20)))
                else:
                    Fq[qi, si] = np.mean(var ** (q / 2)) ** (1 / q)
        log_s   = np.log10(scales)
        hq      = np.array([np.polyfit(log_s, np.log10(Fq[qi] + 1e-20), 1)[0]
                            for qi in range(len(self.q))])
        tau     = self.q * hq - 1
        dq      = self.q[1] - self.q[0] if len(self.q) > 1 else 1.0
        alpha   = np.gradient(tau, dq)
        f_alpha = self.q * alpha - tau
        delta_alpha = float(alpha.max() - alpha.min())
        alpha0      = float(alpha[np.argmax(f_alpha)])
        H_mono      = float(hq[np.argmin(np.abs(self.q - 2.0))])
        return dict(hq=hq, tau=tau, alpha=alpha, f_alpha=f_alpha,
                    delta_alpha=delta_alpha, alpha0=alpha0, H_mono=H_mono,
                    scales=scales, Fq=Fq, q_list=self.q)

    def features(self, x):
        r = self.fit(x)
        return np.array([r["delta_alpha"], r["alpha0"], r["H_mono"]], np.float32)

    def sliding_delta_alpha(self, x, window, stride):
        out = []
        for i in range(0, len(x) - window + 1, stride):
            try:
                out.append(self.fit(x[i:i+window])["delta_alpha"])
            except Exception:
                out.append(float("nan"))
        return np.array(out, np.float32)

    def _variances(self, Y, s):
        N = len(Y); Ns = N // s; t = np.arange(s); vv = []
        for direction in [1, -1]:
            Z = Y if direction == 1 else Y[::-1]
            for v in range(Ns):
                seg   = Z[v*s:(v+1)*s]
                trend = np.polyval(np.polyfit(t, seg, self.poly), t)
                vv.append(max(np.mean((seg - trend) ** 2), 1e-20))
        return np.array(vv)


def build_nl_features(series: np.ndarray, label: str) -> np.ndarray:
    cache = os.path.join(OUT_DIR, f"nl_{label}.npy")
    if os.path.exists(cache):
        print(f"  [MF-DFA] 载入缓存 {cache}")
        return np.load(cache)
    print(f"  [MF-DFA] 计算 {label} (窗={MFDFA_WIN}, 步={MFDFA_STRIDE})...")
    mf    = MFDFA()
    feats = []
    positions = list(range(0, len(series) - MFDFA_WIN + 1, MFDFA_STRIDE))
    for start in tqdm(positions, ncols=70, leave=False):
        feats.append(mf.features(series[start:start+MFDFA_WIN]))
    arr = np.array(feats, np.float32)
    np.save(cache, arr)
    print(f"  [MF-DFA] 完成 shape={arr.shape}, "
          f"Δα={arr[:,0].mean():.4f}±{arr[:,0].std():.4f}")
    return arr


#   3.原始网络模型                       

class AdaptiveTemperature(nn.Module):
       def __init__(self, n_feat=3):
        super().__init__()
        self.gamma  = nn.Parameter(torch.tensor(1.0))
        self.beta   = nn.Parameter(torch.tensor(5.0))
        self.th_net = nn.Sequential(nn.Linear(n_feat, 16), nn.ReLU(), nn.Linear(16, 1))

    def forward(self, feat):         
        da = feat[:, 0:1]
        th = self.th_net(feat)        
        T  = 1.0 + self.gamma * torch.sigmoid(self.beta * (da - th))
        return T.unsqueeze(-1)        


class AdaptiveMHA(nn.Module):
    def __init__(self, d, h, drop=0.1):
        super().__init__()
        self.h = h; self.dk = d // h
        self.Wq = nn.Linear(d, d, bias=False); self.Wk = nn.Linear(d, d, bias=False)
        self.Wv = nn.Linear(d, d, bias=False); self.Wo = nn.Linear(d, d)
        self.drop = nn.Dropout(drop)

    def forward(self, x, T=None):
        B, L, _ = x.shape
        Q = self.Wq(x).view(B, L, self.h, self.dk).transpose(1, 2)
        K = self.Wk(x).view(B, L, self.h, self.dk).transpose(1, 2)
        V = self.Wv(x).view(B, L, self.h, self.dk).transpose(1, 2)
        scale = math.sqrt(self.dk)
        if T is not None:
            scale = scale * T.unsqueeze(1)  
        attn = F.softmax(Q @ K.transpose(-2, -1) / scale, dim=-1)
        attn = self.drop(attn)
        out  = (attn @ V).transpose(1, 2).contiguous().view(B, L, -1)
        return self.Wo(out), attn


class TFLayer(nn.Module):
    def __init__(self, d, h, dff, drop=0.1):
        super().__init__()
        self.attn = AdaptiveMHA(d, h, drop)
        self.ff   = nn.Sequential(nn.Linear(d, dff), nn.GELU(),
                                   nn.Dropout(drop), nn.Linear(dff, d))
        self.n1   = nn.LayerNorm(d); self.n2 = nn.LayerNorm(d)
        self.drop = nn.Dropout(drop)

    def forward(self, x, T=None):
        a, w = self.attn(x, T)
        x = self.n1(x + self.drop(a))
        x = self.n2(x + self.drop(self.ff(x)))
        return x, w


class MFTransformer(nn.Module):
    def __init__(self, window, horizon, d=D_MODEL, h=N_HEADS,
                 n_layers=N_LAYERS, dff=D_FF, nl=NL_DIM,
                 drop=0.1, adaptive=True):
        super().__init__()
        self.adaptive = adaptive
        self.proj   = nn.Linear(1, d)
        self.pos    = nn.Parameter(torch.randn(1, window, d) * 0.02)
        self.nl_enc = nn.Sequential(nn.Linear(nl, 32), nn.ReLU(), nn.Linear(32, nl))
        self.temp   = AdaptiveTemperature(nl) if adaptive else None
        self.layers = nn.ModuleList([TFLayer(d, h, dff, drop) for _ in range(n_layers)])
        self.norm   = nn.LayerNorm(d)
        self.head   = nn.Sequential(nn.Linear(d, dff // 2), nn.GELU(),
                                     nn.Dropout(drop), nn.Linear(dff // 2, horizon))
        self._init()

    def _init(self):
        for m in self.modules():
            if isinstance(m, nn.Linear):
                nn.init.xavier_uniform_(m.weight)
                if m.bias is not None: nn.init.zeros_(m.bias)

    def forward(self, x, nl=None):
        if x.dim() == 2: x = x.unsqueeze(-1)
        h  = self.proj(x) + self.pos
        T  = None
        if self.adaptive and nl is not None:
            T = self.temp(self.nl_enc(nl))
        aws = []
        for layer in self.layers:
            h, aw = layer(h, T)
            aws.append(aw)
        h = self.norm(h).mean(dim=1)
        return self.head(h), aws


class LSTMModel(nn.Module):
    def __init__(self, window, horizon, hidden=128, n_layers=2, drop=0.1):
        super().__init__()
        self.lstm = nn.LSTM(1, hidden, n_layers, batch_first=True, dropout=drop)
        self.head = nn.Linear(hidden, horizon)

    def forward(self, x, nl=None):
        if x.dim() == 2: x = x.unsqueeze(-1)
        out, _ = self.lstm(x)
        return self.head(out[:, -1]), []


# ──全局统计量的 sigmoid 归一化 ─────────────────────

class DynPenaltyLoss(nn.Module):
    def __init__(self, lam: float = 2.0, da_mean: float = 0.0, da_std: float = 1.0):
        super().__init__()
        self.lam = lam
        self.register_buffer("da_mean", torch.tensor(float(da_mean)))
        self.register_buffer("da_std",  torch.tensor(float(da_std)))

    def forward(self, pred, target, da=None):
        loss = F.mse_loss(pred, target, reduction="none").mean(-1)
        if da is not None:
            da_norm = torch.sigmoid((da - self.da_mean) / (self.da_std + 1e-8))
            w       = 1.0 + self.lam * da_norm
            loss    = (w * loss).mean()
        else:
            loss = loss.mean()
        return loss


