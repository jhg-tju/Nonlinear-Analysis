def make_loaders(X_tr, X_v, X_te, y_tr, y_v, y_te, nl_tr, nl_v, nl_te):
    def dl(X, y, nl, shuf):
        ds = TensorDataset(torch.FloatTensor(X), torch.FloatTensor(y),
                           torch.FloatTensor(nl))
        return DataLoader(ds, batch_size=BATCH, shuffle=shuf, num_workers=0)
    return (dl(X_tr, y_tr, nl_tr, True),
            dl(X_v,  y_v,  nl_v,  False),
            dl(X_te, y_te, nl_te, False))


def _make_truncated_loader(loader, nl_dim: int, shuffle: bool = False) -> DataLoader:
    Xs, ys, nls = [], [], []
    for xb, yb, nl in loader:
        Xs.append(xb); ys.append(yb); nls.append(nl[:, :nl_dim])
    ds = TensorDataset(torch.cat(Xs), torch.cat(ys), torch.cat(nls))
    return DataLoader(ds, batch_size=BATCH, shuffle=shuffle, num_workers=0)


def train(model, loaders, name, use_nl=True, da_mean=0.0, da_std=1.0):
    model = model.to(DEVICE)
    opt   = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=WD)
    sch   = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS)
    crit  = DynPenaltyLoss(lam=2.0 if use_nl else 0.0,
                           da_mean=da_mean, da_std=da_std)
    tr_lo, val_lo = [], []
    best_val, best_sd = 1e9, None
    tr_loader, val_loader, _ = loaders
    bar = tqdm(range(1, EPOCHS + 1), desc=f"  {name}", ncols=80, leave=True)
    for ep in bar:
        model.train(); tl = 0
        for xb, yb, nl in tr_loader:
            xb, yb, nl = xb.to(DEVICE), yb.to(DEVICE), nl.to(DEVICE)
            opt.zero_grad()
            pred, _ = model(xb, nl if use_nl else None)
            loss = crit(pred, yb, da=nl[:, 0] if use_nl else None)
            loss.backward()
            nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            opt.step(); tl += loss.item()
        sch.step()
        model.eval(); vl = 0
        with torch.no_grad():
            for xb, yb, nl in val_loader:
                xb, yb, nl = xb.to(DEVICE), yb.to(DEVICE), nl.to(DEVICE)
                pred, _ = model(xb, nl if use_nl else None)
                vl += crit(pred, yb).item()
        tl /= len(tr_loader); vl /= len(val_loader)
        tr_lo.append(tl); val_lo.append(vl)
        bar.set_postfix({"train": f"{tl:.5f}", "val": f"{vl:.5f}"})
        if vl < best_val:
            best_val = vl
            best_sd  = {k: v.clone() for k, v in model.state_dict().items()}
    model.load_state_dict(best_sd)
    np.save(f"{OUT_DIR}/{name}_tr.npy",  tr_lo)
    np.save(f"{OUT_DIR}/{name}_val.npy", val_lo)
    return model, tr_lo, val_lo


def evaluate(model, test_loader, use_nl=True, extreme_threshold=None):
    model.eval()
    preds, tgts, aws_all, nl_collected = [], [], [], []
    with torch.no_grad():
        for xb, yb, nl in test_loader:
            xb, nl = xb.to(DEVICE), nl.to(DEVICE)
            pred, aws = model(xb, nl if use_nl else None)
            preds.append(pred.cpu().numpy())
            tgts.append(yb.numpy())
            nl_collected.append(nl.cpu().numpy())
            if aws:
                    attn_l0 = aws[0].cpu().numpy()   # shape: (B, H, T, T)
                for b_i in range(attn_l0.shape[0]):
                    aws_all.append(attn_l0[b_i, 0])  # head 0

    preds  = np.concatenate(preds)
    tgts   = np.concatenate(tgts)
    nl_cat = np.concatenate(nl_collected, axis=0)   # (N_test, NL_DIM)

    flat_p = preds.flatten(); flat_t = tgts.flatten()
    rmse   = math.sqrt(mean_squared_error(flat_t, flat_p))
    mae    = mean_absolute_error(flat_t, flat_p)
    cc     = float(np.corrcoef(flat_t, flat_p)[0, 1])

    if extreme_threshold is not None:
        t_ext = tgts.max(axis=1)  > extreme_threshold
        p_ext = preds.max(axis=1) > extreme_threshold
    else:
        all_diffs = np.abs(np.diff(tgts,  axis=1)).flatten()
        thr       = float(np.percentile(all_diffs, 80))
        t_ext = (np.abs(np.diff(tgts,  axis=1)) > thr).any(1)
        p_ext = (np.abs(np.diff(preds, axis=1)) > thr).any(1)
    f1 = f1_score(t_ext, p_ext, zero_division=0)

    return dict(RMSE=rmse, MAE=mae, CC=cc, F1=f1,
                preds=preds, tgts=tgts,
                attn_weights=aws_all,   # flat list of (T,T) matrices
                nl_inputs=nl_cat)       # (N_test, NL_DIM) standardized


# ── FIX3: evaluate_svr — 正确的样本外评估 ─────────────────────────────────────

def evaluate_svr(X_tr, y_tr, nl_tr, X_te, y_te, nl_te):
    feat_tr = np.concatenate([nl_tr, X_tr[:, -24:]], axis=1)
    feat_te = np.concatenate([nl_te, X_te[:, -24:]], axis=1)
    tgt_tr  = y_tr[:, 0]
    tgt_te  = y_te[:, 0]
    sc = StandardScaler()
    feat_tr = sc.fit_transform(feat_tr)
    feat_te = sc.transform(feat_te)     
    svr = SVR(kernel="rbf", C=10, gamma="scale")
    svr.fit(feat_tr, tgt_tr)              
    p_te   = svr.predict(feat_te)     
    rmse   = math.sqrt(mean_squared_error(tgt_te, p_te))
    mae    = mean_absolute_error(tgt_te, p_te)
    cc     = float(np.corrcoef(tgt_te, p_te)[0, 1])
    return dict(RMSE=rmse, MAE=mae, CC=cc, F1=float("nan"),
                preds=p_te[:, None], tgts=tgt_te[:, None])


